%% Canonical end-to-end flow.
%% This diagram is the source-of-truth overview for parsing, chunking, publish, and retrieval.

flowchart TD
    A([Canonical Markdown body<br/>validated by markdown_reader])
    B[split_body_by_page_markers]
    C[PageBlock list<br/>markers/comments consumed]
    D[structural_parser.parse_page_blocks]
    E[StructuralParseResult<br/>blocks + validation reports]
    F[parent_builder.build_parent_sections]
    G[ParentSection list<br/>non-overlapping, multi-page aware]
    H[child_builder.build_structural_child_units]
    I[Atomic ChildUnit list]
    J[oversized_unit_splitter.split_units]
    K[chunk_factory<br/>Parent chunks + Child chunks]
    L[embedding_text_builder<br/>Child only]
    M[chunk_validator]
    N{Any error?}
    O([Stop publish<br/>return errors])
    P[(PostgreSQL<br/>canonical content + structural metadata)]
    Q{publish?}
    R([Preview-only result])
    S[Embed Child chunks]
    T[(Qdrant<br/>vectors + structural payload)]
    U([Published])

    A --> B --> C --> D --> E --> F --> G --> H --> I --> J --> K --> L --> M --> N
    N -->|yes| O
    N -->|no| P --> Q
    Q -->|no| R
    Q -->|yes| S --> T --> U

    V([User query])
    W[Apply shared hard filters]
    X[(Qdrant dense candidates)]
    Y[(PostgreSQL FTS/BM25 candidates)]
    Z[RRF or weighted fusion]
    AA[Hydrate fused canonical content<br/>and structural metadata from PostgreSQL]
    AB[Rerank fused candidates]
    AC[Structural expansion<br/>parent, children, siblings, split neighbors]
    AD[Deduplicate + source order<br/>context budget]
    AE[Build citations]
    AF([Answer context])

    V --> W
    W --> X
    W --> Y
    X --> Z
    Y --> Z
    Z --> AA --> AB --> AC --> AD --> AE --> AF
    T -. searchable Child vectors .-> X
    P -. FTS corpus + canonical source .-> Y
    P -. canonical content + structural metadata .-> AA

    D -. never reparses per Parent .-> H
    E -. warnings continue by default<br/>errors block publish .-> M
