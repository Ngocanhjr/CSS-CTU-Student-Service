      "link": null,
      "locked": false,
      "text": "Orchestrator only\n\n• read_markdown_document\n• Index eligible?\nocr_status = done AND\nreview_status = approved\n• chunk_markdown_body\n• PostgreSQL transaction\nreplace Parent/Child chunks\ncanonical content + parent relations\n• Embed Child chunks\n• Upsert deterministic points",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "containerId": "group-0",
      "originalText": "Orchestrator only\n\n• read_markdown_document\n• Index eligible?\nocr_status = done AND\nreview_status = approved\n• chunk_markdown_body\n• PostgreSQL transaction\nreplace Parent/Child chunks\ncanonical content + parent relations\n• Embed Child chunks\n• Upsert deterministic points",
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "ai"
