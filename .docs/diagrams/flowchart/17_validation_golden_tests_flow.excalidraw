      "link": null,
      "locked": false,
      "index": "a20",
      "text": "Every marker is represented\nno Parent-boundary spill\nnested item requires\nparent_item_key\ntop-level item may have\nparent_item_key=None\npage marker/comment absent\ntable/code atomic\nbullet group has\nlogical_item_keys\nsplit metadata consistent\nParent has Child or\ncontext_only_reason",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
