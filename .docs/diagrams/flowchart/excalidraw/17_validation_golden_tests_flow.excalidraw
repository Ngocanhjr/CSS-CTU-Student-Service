      "updated": 1783699200000,
      "link": null,
      "locked": false,
      "text": "Every marker is represented\nno Parent-boundary spill\nnested item requires\nparent_item_key\ntop-level item may have\nparent_item_key=None\npage marker/comment absent\ntable/code atomic before\nsafe oversized split\nbullet group has\nlogical_item_keys\nsplit metadata consistent\nParent has Child or\ncontext_only_reason",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 20,
      "containerId": "node-J",
      "originalText": "Every marker is represented\nno Parent-boundary spill\nnested item requires parent_item_key\ntop-level item may have parent_item_key=None\npage marker/comment absent\ntable/code atomic before safe oversized split\nbullet group has logical_item_keys\nsplit metadata consistent\nParent has Child or context_only_reason",
      "autoResize": true,
      "lineHeight": 1.25
    },
