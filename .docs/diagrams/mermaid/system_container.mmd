graph TB
    subgraph Frontend
        Flutter[Flutter App<br/>Mobile/Web]
    end
    
    subgraph Backend
        API[Backend API<br/>FastAPI]
        RAG[RAG Service]
        Ingestion[Ingestion Service]
    end
    
    subgraph Data
