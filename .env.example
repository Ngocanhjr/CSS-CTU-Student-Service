# Runtime environment
TZ=Asia/Ho_Chi_Minh

# PostgreSQL / Neon
# Use an async SQLAlchemy URL. Keep the real value only in .env or the host's secret store.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ctu_chunks_bge_m3

# Cloudflare R2 canonical Markdown and source files
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# Cloudflare Workers AI embeddings
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_BATCH_SIZE=4

# LLM provider
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Optional Jina reranker. Leave JINA_API_KEY empty to keep the base ranking.
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v3
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_TIMEOUT=8
