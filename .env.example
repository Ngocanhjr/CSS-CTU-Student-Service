# Runtime
TZ=Asia/Ho_Chi_Minh

# # PostgreSQL / Docker Compose
# POSTGRES_DB=ctu_student_service
# POSTGRES_USER=ctu_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://ctu_user:change-me@localhost:5432/ctu_student_service

# # Qdrant / Docker Compose
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334
# QDRANT_LOG_LEVEL=INFO
# QDRANT_TELEMETRY_DISABLED=true
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=ctu_chunks_bge_m3

# Cloudflare Workers AI embedding
CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_API_TOKEN=change-me
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_BATCH_SIZE=4

# Cloudflare R2 object storage
R2_ENDPOINT_URL=https://change-me.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=change-me
R2_REGION=auto

# OpenAI-compatible LLM (defaults target OpenRouter/Qwen)
LLM_API_KEY=change-me
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct
LLM_TIMEOUT_SECONDS=45

# Query rewrite
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_QUERIES=3
QUERY_REWRITE_TIMEOUT_SECONDS=12

# Optional Jina reranker; leave JINA_API_KEY empty to keep RRF ranking
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v3
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_TIMEOUT=8
