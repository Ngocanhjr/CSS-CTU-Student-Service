    {
      "type": "text",
      "id": "migration_txt",
      "x": 80,
      "y": 955,
      "width": 620,
      "height": 120,
      "text": "19_MIGRATE_10_TO_9_TABLES: dropped document_version_status\n(folded ocr/review/rag_status onto document_versions) and\ndocument_version_relationships (unused). Added document_recipients\n(M:N, replaces documents.department_id). chunk_level→chunk_type was\nrenamed earlier, NOT part of this migration.",
      "originalText": "19_MIGRATE_10_TO_9_TABLES: dropped document_version_status\n(folded ocr/review/rag_status onto document_versions) and\ndocument_version_relationships (unused). Added document_recipients\n(M:N, replaces documents.department_id). chunk_level→chunk_type was\nrenamed earlier, NOT part of this migration.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#22c55e",
